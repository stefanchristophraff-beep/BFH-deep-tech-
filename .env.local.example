# Airtable Integration
# Get your API key at: https://airtable.com/account
AIRTABLE_API_KEY=your_airtable_api_key_here

# Your Airtable Base ID (found in the API docs for your base)
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# The name of your table in Airtable
AIRTABLE_TABLE_NAME=Support Programs

# Formspree Form ID
# Create a free form at: https://formspree.io
# The ID is the part after /f/ in your form URL
NEXT_PUBLIC_FORMSPREE_FORM_ID=your_form_id_here
