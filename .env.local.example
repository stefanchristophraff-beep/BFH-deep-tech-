# Airtable Integration
# Get your Personal Access Token at: https://airtable.com/account -> Developer Hub
AIRTABLE_API_KEY=your_airtable_personal_access_token

# Your Airtable Base ID (from the URL: airtable.com/appXXXXXX/...)
AIRTABLE_BASE_ID=appJn6vW6UO1JSDvd

# Exact table name as it appears in Airtable
AIRTABLE_TABLE_NAME=Deep-Tech Kommerzialisierungsradar

# Formspree Form ID (from https://formspree.io — the part after /f/ in your form URL)
NEXT_PUBLIC_FORMSPREE_FORM_ID=your_form_id_here
